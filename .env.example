# ---------------------------------------------------------------------------
# AIOnSite -- environment template.  Copy to `.env` and edit.  Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development           # development | testing | production
LOG_LEVEL=INFO

# --- LLM provider -------------------------------------------------------
# openai | local | ollama | vllm | echo
#   echo  -> deterministic, offline, no server needed (demos / tests)
#   ollama/vllm/local -> on-premise
LLM_PROVIDER=ollama

# --- OpenAI (cloud; disabled automatically when SOVEREIGN_MODE=true) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Generic local OpenAI-compatible server ----------------------------
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_API_KEY=local

# --- Ollama ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- vLLM ------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local

# --- Model parameters -------------------------------------------------
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
REQUEST_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10      # fails fast if the provider isn't reachable at all
LLM_READ_TIMEOUT_SECONDS=300        # raise further if your machine is slower still (CPU-only local models can be slow to load)

# --- Orchestration limits ------------------------------------------
MAX_RETRIES=2
MAX_REPLANS=1
NODE_TIMEOUT_SECONDS=300            # keep >= LLM_READ_TIMEOUT_SECONDS -- this wraps the whole node, including the LLM call

# --- Sovereignty ---------------------------------------------------
# true  -> cloud providers are refused; all inference stays on this machine
SOVEREIGN_MODE=true

# --- Sandboxed code execution (execute_python tool) --------------------
# false -> the tool is not even registered; agents cannot run arbitrary code
SANDBOX_ENABLED=false
SANDBOX_USE_DOCKER=false            # true -> real container isolation (needs Docker); else subprocess-only fallback
# SANDBOX_DOCKER_IMAGE=python:3.11-slim
# SANDBOX_TIMEOUT_SECONDS=10
# SANDBOX_MEMORY_LIMIT_MB=256
# SANDBOX_CPU_LIMIT=1.0

# --- Output-writing tools (generate_word_document, ...) -----------------
# false -> ToolPermission.WRITE_FILESYSTEM is never granted; no tool can
# write to disk. Generated files (when enabled) are served read-only at
# GET /files/<filename>.
OUTPUT_WRITING_ENABLED=false
